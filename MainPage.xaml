<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Emajstor.MainPage">

    <Grid RowDefinitions="60,*, 60"
     ColumnDefinitions=".45*,.45*,.45*" 
       RowSpacing="10"
       ColumnSpacing="10"
       BackgroundColor="White">
        <BoxView Color="LightGray" 
                 Grid.Column="0"
                 Grid.ColumnSpan="3"
                 Grid.Row="0"/>
        <Button Grid.ColumnSpan="1"
                Grid.Column="0"
                Grid.Row="0"
                Text="Poslovi"
                BackgroundColor="LightGray"
                HorizontalOptions="Start"
                TextTransform="Default"
                FontAttributes="Bold"
                FontSize="Micro"
                Margin="10,5,10,5"
                CornerRadius="10"
                BorderWidth="3"
                BorderColor="Gray"
                SemanticProperties.Description="Dugme da bi korisnik izabrao koji posao mu treba raditi (posao)"
                />
        <Image Source="logo.png"
               Grid.ColumnSpan="1"
               Grid.Column="1"
               Grid.Row="0"
               WidthRequest="200"
               HeightRequest="200"
               MinimumWidthRequest="50"
               MinimumHeightRequest="50"
               BackgroundColor="Transparent"
               SemanticProperties.Description="logo e-majstora"
               />
        <ImageButton Source="defaultprofilna.png"
               Grid.ColumnSpan="1"
               Grid.Column="2"
               Grid.Row="0"
               HorizontalOptions="End"
               WidthRequest="170"
               HeightRequest="170"
               MinimumWidthRequest="50"
               MinimumHeightRequest="50"
               BackgroundColor="Transparent"
               SemanticProperties.Description="profilna slika korisnika"
               />

        <Grid Grid.Row="1"
              Grid.RowSpan="1"
              Grid.Column="2"
              Grid.ColumnSpan="1"
              RowDefinitions="auto,auto,auto,auto,auto,auto"
              ColumnDefinitions=".45*,.45*,.45*"
              RowSpacing="10"
              ColumnSpacing="5"
              Margin="10" >
            <BoxView Grid.Row="0"
                     Grid.RowSpan="5"
                     Grid.Column="0"
                     Grid.ColumnSpan="3"
                     Color="Gray"
                     CornerRadius="15"/>
            <Label Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="3"
                   Text="Filteri"
                   FontAttributes="Bold"
                   FontSize="Small"
                   HorizontalOptions="Center"
                   TextColor="White"
                   TextDecorations="Underline"
                   SemanticProperties.Description="Title za stranicu"
                   />
            <Label Grid.Row="2"
                   Grid.Column="0"
                   Grid.ColumnSpan="3"
                   HorizontalOptions="Center"
                   Text="Mesto"
                   TextColor="White"
                   FontSize="Small"
                   SemanticProperties.Description="Title gde se ukucava mesto"
                />
            <Entry Grid.Row="3"
                   Grid.Column="0"
                   Grid.ColumnSpan="1"
                   Grid.RowSpan="1"
                   Placeholder="Država"
                   PlaceholderColor="LightGray"
                   BackgroundColor="Gray"
                   HorizontalOptions="Center"
                   WidthRequest="100"
                   />
            <Entry Grid.Row="3"
                   Grid.Column="1"
                   Grid.ColumnSpan="1"
                   Grid.RowSpan="1"
                   Placeholder="Grad"
                   PlaceholderColor="LightGray"
                   BackgroundColor="Gray"
                   HorizontalOptions="Center"
                   WidthRequest="100"
                   />
            <Entry Grid.Row="3"
                   Grid.Column="2"
                   Grid.ColumnSpan="1"
                   Grid.RowSpan="1"
                   Placeholder="Opština"
                   PlaceholderColor="LightGray"
                   BackgroundColor="Gray"
                   HorizontalOptions="Center"
                   WidthRequest="100"
                   />
            <Label Grid.Row="4"
                   Grid.Column="0"
                   Grid.ColumnSpan="3"
                   HorizontalOptions="Center"
                   Text="Popularnost"
                   TextColor="White"
                   FontSize="Small"
                   SemanticProperties.Description="Title za popularnost"
                   />
            <!--checkbox za recenzije, checkbox za dostupnost(opcija za urgentne poslove), ?cena?)-->
            <!--poslovi DD?, novi grid za to, pokaze se kada bude bilo klikovano na i skloni, scroll??-->

            

        </Grid>


    </Grid>

</ContentPage>
